{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAVIX",
  "version": "0.2.1",
  "identifier": "com.ravix.recorder",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RAVIX",
        "width": 1060,
        "height": 700,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0MUY2NjVDQzZGMDcxNzQKUldSMGNmREdYR1lmcEZWNVZERHdsVEdDRHlDNkoyc2lWdnhTdjJCb3k1cnRha1FVWmZBbTJjd0IK",
      "endpoints": [
        "https://github.com/ravix-app/ravix/releases/latest/download/latest.json"
      ]
    }
  }
}
